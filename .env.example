# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_TMDB_KEY: Completely optional TMDB v3 API key for live Trending, Top Rated, Action, and Popular TV rows.
# If omitted or set to a dummy value, KHLD+ automatically falls back to local library.json data.
VITE_TMDB_KEY=""

# STREAM_EXTRACTOR_URL: Completely optional upstream extractor URL or template for api/stream-extractor.ts.
# If omitted or set to a dummy value, the app runs without errors using local fallback streams.
STREAM_EXTRACTOR_URL=""
